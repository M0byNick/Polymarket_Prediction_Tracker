<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weather forecast arb collector — interim local DB backup.

  Runs scripts/launchd/weather_arb_backup.sh once daily (03:30 local). Each
  run writes a transaction-consistent, date-stamped copy of the collector
  DB to /Users/nicholasmorihisa/trading-data-backup/weather/. This is an
  INTERIM on-machine backup; off-machine backup (e.g. GitHub) is a separate
  task.

  Install:
    cp scripts/launchd/com.nmtrading.weather-arb-backup.plist \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.nmtrading.weather-arb-backup.plist
    launchctl list | grep weather

  DEPLOYMENT NOTE (2026-05-19): the backup script lives in the dedicated
  weather worktree, Tracker_Poly_weather (weather-forecast-arb-scaffold
  branch). The previous plist pointed at .../Tracker_Poly/scripts/launchd/,
  which is the sibling crypto checkout — the weather backup script is not on
  disk there, so /bin/bash exited 127 (command/file not found) every run.
  The path below points at the weather worktree where the script exists.

  This file in the repo is the source of truth; the loaded copy lives at
  ~/Library/LaunchAgents/com.nmtrading.weather-arb-backup.plist.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nmtrading.weather-arb-backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/nicholasmorihisa/Code/Trade_Organizer/Prediction_Markets/Tracker_Poly_weather/scripts/launchd/weather_arb_backup.sh</string>
    </array>

    <!-- Daily at 03:30 local time. launchd runs a missed job at next wake
         if the machine was asleep at the scheduled time. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>3</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/nicholasmorihisa/trading-data/weather/logs/weather-arb-backup.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nicholasmorihisa/trading-data/weather/logs/weather-arb-backup.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
