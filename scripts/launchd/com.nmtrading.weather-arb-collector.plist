<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weather forecast arb collector — persistent local daemon.

  Runs strategies/weather_forecast_arb via scripts/weather_arb_runner.py
  (a 30-minute internal loop; WEATHER_ARB_INTERVAL overrides). OBSERVE-ONLY:
  the collector logs strategy DECISIONS and market/forecast snapshots into
  the SQLite DB; it places no orders and touches no wallet.

  Install:
    cp scripts/launchd/com.nmtrading.weather-arb-collector.plist \
       ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.nmtrading.weather-arb-collector.plist
    launchctl list | grep weather

  This file in the repo is the source of truth; the loaded copy lives at
  ~/Library/LaunchAgents/com.nmtrading.weather-arb-collector.plist.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.nmtrading.weather-arb-collector</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/nicholasmorihisa/Code/Trade_Organizer/Prediction_Markets/Tracker_Poly/.venv/bin/python</string>
        <string>-u</string>
        <string>scripts/weather_arb_runner.py</string>
    </array>

    <!-- weather_arb_runner.py invokes scripts/weather_arb_collect.py by a
         relative path, so the working directory must be the repo root. -->
    <key>WorkingDirectory</key>
    <string>/Users/nicholasmorihisa/Code/Trade_Organizer/Prediction_Markets/Tracker_Poly</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>WEATHER_ARB_DB</key>
        <string>/Users/nicholasmorihisa/trading-data/weather/weather_arb.db</string>
        <key>WEATHER_ARB_HEARTBEAT</key>
        <string>/Users/nicholasmorihisa/trading-data/weather/.heartbeat_weather_arb</string>
        <key>WEATHER_ARB_INTERVAL</key>
        <string>1800</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Don't hot-loop if the process exits immediately. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>/Users/nicholasmorihisa/trading-data/weather/logs/weather-arb-collector.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/nicholasmorihisa/trading-data/weather/logs/weather-arb-collector.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
